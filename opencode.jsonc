{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "heroui-react": {
        "type": "local",
        "command": ["bunx", "-y", "@heroui/react-mcp@latest"]
      }
    }
  },
  "plugins": [
    {
      "package": "opencode-tps-meter@latest",
      "options": { "showElapsed": true, "enableColorCoding": true }
    }
  ]
}
