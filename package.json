{
  "name": "iris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal, always-available desktop AI assistant for macOS.",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "vite:dev": "vite --port=3002",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug --config src-tauri/tauri.dev.conf.json",
    "tauri:build:mac:arm64": "tauri build --target aarch64-apple-darwin",
    "tauri:build:mac:x64": "tauri build --target x86_64-apple-darwin",
    "tauri:build:mac": "bun run tauri:build:mac:arm64 && bun run tauri:build:mac:x64",
    "tsc:check": "tsc --noEmit --skipLibCheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "bot-avatars": "^0.2.2",
    "clsx": "^2.1.1",
    "konva": "^10.9.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.23",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,jsonc,css,html}": ["biome check --write --no-errors-on-unmatched"]
  }
}
