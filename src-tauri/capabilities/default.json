{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the Iris windows",
  "windows": ["main", "overlay", "canvas", "capture", "preview"],
  "permissions": [
    "autostart:default",
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-theme",
    "dialog:default",
    "opener:default",
    "log:default",
    "shell:default"
  ]
}
