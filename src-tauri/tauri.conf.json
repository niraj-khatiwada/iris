{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Iris",
  "version": "0.1.0",
  "identifier": "com.iris.desktop",
  "build": {
    "beforeDevCommand": "bun run vite:dev",
    "devUrl": "http://localhost:3002",
    "beforeBuildCommand": "bun run vite:build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Iris",
    "shortDescription": "Your personal desktop AI assistant",
    "longDescription": "A fast, private, always-available desktop AI assistant for macOS.",
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Iris",
        "url": "overlay.html",
        "width": 792,
        "height": 120,
        "minWidth": 600,
        "minHeight": 100,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "acceptFirstMouse": true,
        "fullscreen": false
      },
      {
        "label": "capture",
        "title": "Iris Capture",
        "url": "capture.html",
        "width": 100,
        "height": 100,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "acceptFirstMouse": true,
        "fullscreen": false
      },
      {
        "label": "canvas",
        "title": "Iris Canvas",
        "url": "canvas.html",
        "width": 100,
        "height": 100,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": false,
        "fullscreen": false
      },
      {
        "label": "main",
        "title": "Iris",
        "width": 1240,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:3002 http://localhost:3002; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  }
}
